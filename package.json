{
  "name": "xiaozhi-desktop",
  "version": "1.1.0",
  "description": "小智桌面",
  "author": "junsen",
  "homepage": "https://github.com/huangjunsen0406/xiaozhi-desktop",
  "main": "./out/main/index.js",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "clean": "node -e \"require('fs').rmSync('release', {recursive: true, force: true})\"",
    "build:win": "pnpm run clean && pnpm run build && electron-builder --win --publish=never",
    "verify:sherpa": "node -e \"const fs=require('fs');const p=process.platform==='win32'?'sherpa-onnx-win-x64':process.platform==='darwin'?(process.arch==='arm64'?'sherpa-onnx-darwin-arm64':'sherpa-onnx-darwin-x64'):'sherpa-onnx-linux-x64';const f='node_modules/'+p+'/sherpa-onnx.node';if(!fs.existsSync(f)){console.error('❌ Missing:',f);process.exit(1)}console.log('✅ Found:',f)\"",
    "build:mac": "pnpm run clean && pnpm run build && electron-builder --mac --publish=never",
    "build:linux": "pnpm run clean && pnpm run build && electron-builder --linux --publish=never",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@pixi/unsafe-eval": "6.5.10",
    "@types/uuid": "^11.0.0",
    "@vueuse/core": "^13.9.0",
    "async-mutex": "^0.5.0",
    "axios": "^1.13.2",
    "better-sqlite3": "^12.4.1",
    "easy-volume": "^1.2.0",
    "electron-updater": "^6.3.9",
    "getmac": "^6.6.0",
    "lamejs": "^1.2.1",
    "mqtt": "^5.14.1",
    "node-screenshots": "^0.2.1",
    "openai": "^6.9.1",
    "opusscript": "^0.1.1",
    "pinia": "^3.0.4",
    "pinyin": "^4.0.0",
    "pixi-live2d-display": "0.4.0",
    "pixi.js": "6.5.10",
    "sharp": "^0.34.5",
    "sherpa-onnx-node": "^1.12.31",
    "uiohook-napi": "1.5.4",
    "uuid": "^13.0.0",
    "vue-router": "^4.5.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.3.0",
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/rebuild": "^4.0.1",
    "@iconify-json/carbon": "^1.2.13",
    "@iconify-json/mdi": "^1.2.3",
    "@tailwindcss/vite": "^4.1.17",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.16.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "baseline-browser-mapping": "^2.10.28",
    "electron": "^37.2.3",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.4.0",
    "naive-ui": "^2.43.0",
    "prettier": "^3.6.2",
    "terser": "^5.44.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8",
    "unplugin-auto-import": "^20.1.0",
    "unplugin-icons": "^22.3.0",
    "unplugin-vue-components": "^29.0.0",
    "vite": "^7.0.5",
    "vue": "^3.5.17",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "better-sqlite3"
    ]
  }
}
