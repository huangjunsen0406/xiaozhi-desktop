# 使用国内镜像拉包（若你不需要可删掉此行）
registry=https://registry.npmmirror.com

# Electron 主程序二进制镜像
electron_mirror=https://npmmirror.com/mirrors/electron/

# electron-builder 依赖的二进制镜像（7zip、nsis 等）
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/

# 让 pnpm 更“npm-like”的扁平 hoist，避免部分打包/导入找不到依赖
shamefully-hoist=true

# 下载更稳：增加重试与超时（可选）
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000

# 限制并发，弱网下更稳（可选，数值可调）
network-concurrency=6

# 安装所有平台的 optionalDependencies（跨平台打包需要）
supportedArchitectures.os=linux,win32,darwin
supportedArchitectures.cpu=x64,arm64,ia32
